"""Configuration centrale : indicateurs, domaines, unités, sens du danger.

Un seul endroit à modifier pour ajouter un indicateur au système.
"""

# Ordre d'affichage des domaines (système physiologique évalué)
DOMAIN_ORDER = [
    "Cardiovasculaire",
    "Os et muscles",
    "Neuro-oculaire",
    "Colonne vertébrale",
    "Sang et immunité",
    "Radiation",
    "Comportement",
]

# indicateur -> métadonnées
#   domain    : système physiologique auquel il contribue
#   direction : sens dangereux d'un écart ("up", "down" ou "both")
#   label/unit: affichage
#   decimals  : précision d'affichage
INDICATORS = {
    "resting_hr":    {"domain": "Cardiovasculaire",   "direction": "both", "label": "Fréquence cardiaque au repos", "unit": "bpm",   "decimals": 0},
    "hrv":           {"domain": "Cardiovasculaire",   "direction": "down", "label": "Variabilité cardiaque (RMSSD)", "unit": "ms",    "decimals": 0},
    "exercise_min":  {"domain": "Os et muscles",      "direction": "down", "label": "Activité physique",             "unit": "min/j", "decimals": 0},
    "weight":        {"domain": "Os et muscles",      "direction": "down", "label": "Poids",                         "unit": "kg",    "decimals": 1},
    "visual_acuity": {"domain": "Neuro-oculaire",     "direction": "down", "label": "Acuité visuelle",               "unit": "",      "decimals": 2},
    "back_pain":     {"domain": "Colonne vertébrale", "direction": "up",   "label": "Douleur dorsale",               "unit": "/10",   "decimals": 1},
    "fatigue":       {"domain": "Sang et immunité",   "direction": "up",   "label": "Indice de fatigue",             "unit": "/10",   "decimals": 1},
    "hemoglobin":    {"domain": "Sang et immunité",   "direction": "down", "label": "Hémoglobine (proxy globules rouges)", "unit": "g/dL", "decimals": 1},
    "dose_rate":     {"domain": "Radiation",          "direction": "up",   "label": "Débit de dose",                 "unit": "mSv/j", "decimals": 2},
    "sleep_hours":   {"domain": "Comportement",       "direction": "down", "label": "Sommeil",                       "unit": "h",     "decimals": 1},
    "mood":          {"domain": "Comportement",       "direction": "down", "label": "Humeur (questionnaire)",        "unit": "/10",   "decimals": 1},
    "stress":        {"domain": "Comportement",       "direction": "up",   "label": "Stress quotidien",              "unit": "/10",   "decimals": 1},
}

DOMAINS = {k: v["domain"] for k, v in INDICATORS.items()}
DIRECTION = {k: v["direction"] for k, v in INDICATORS.items()}
LABELS = {k: v["label"] for k, v in INDICATORS.items()}
UNITS = {k: v["unit"] for k, v in INDICATORS.items()}
DECIMALS = {k: v["decimals"] for k, v in INDICATORS.items()}

SCENARIO_NAMES = {
    "normal": "Mission nominale",
    "sleep_stress": "Dégradation sommeil et stress",
    "solar_event": "Éruption solaire",
    "deconditioning": "Déconditionnement musculo-squelettique",
    "sans_risk": "Risque neuro-oculaire (SANS)",
}

# Jour d'ouverture suggéré par scénario (là où l'événement est visible)
SCENARIO_FOCUS = {"solar_event": 104}
